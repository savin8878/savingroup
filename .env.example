# Blog posts are read from Supabase Postgres (table public.blog_posts).
# Runtime connection: the read-only `blog_reader` role through the transaction
# pooler (port 6543). Required — builds fail without it. See supabase/README.md.
DATABASE_URL="postgresql://blog_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Admin connection (session pooler, port 5432) — only for schema changes and
# seeding from your machine. Do NOT add this one to Vercel.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Shared secret for POST /api/revalidate/blog (Supabase webhook header
# `x-revalidate-secret`). Optional; without it edits appear within ~6 minutes.
BLOG_REVALIDATE_SECRET="<long-random-string>"

# Savin Operator (the site-wide AI chat panel, POST /api/operator).
# Needs at least ONE model provider below. Keys are server-only — never prefix
# them with NEXT_PUBLIC_. With none set, the route answers 503 and the panel
# shows an "unavailable" message instead of replying.
#
# Every provider whose key is set is used, in this order:
#   anthropic, groq, cerebras, gemini, mistral, openrouter, custom
# When one fails before the visitor sees anything (rate limit, daily quota,
# outage, bad key, retired model), the next one answers, and the failed one
# is skipped for a while. Set OPERATOR_PROVIDERS to choose the order yourself:
# OPERATOR_PROVIDERS="gemini,groq,cerebras"
#
# One Operator request is ~10k input tokens (system prompt + tool schemas)
# before the conversation, and a reply can take several calls. Groq's FREE
# tier allows 8k tokens a minute, so it refuses every request (413) and the
# next provider answers; Groq works on its paid Developer tier. Keep at least
# one generous free tier (Gemini, Cerebras, Mistral) in the chain.
#
# Each provider also takes <PREFIX>_MODEL (one model, or several
# comma-separated, tried in order), <PREFIX>_MAX_TOKENS,
# <PREFIX>_REASONING_EFFORT and <PREFIX>_BASE_URL (prefixes: GROQ, CEREBRAS,
# GEMINI, MISTRAL, OPENROUTER, OPENAI_COMPATIBLE, ANTHROPIC). The model must
# support tool (function) calling.

# Groq — https://console.groq.com/keys (default model openai/gpt-oss-120b)
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"

# Cerebras — https://cloud.cerebras.ai (default model gpt-oss-120b)
CEREBRAS_API_KEY=""

# Google Gemini — https://aistudio.google.com/apikey (default models
# gemini-flash-latest, then gemini-flash-lite-latest when Flash is overloaded)
# Note: on Gemini's free tier Google may use prompts to improve its products.
GEMINI_API_KEY=""

# Mistral — https://console.mistral.ai (default mistral-small-latest)
MISTRAL_API_KEY=""

# OpenRouter — https://openrouter.ai/keys. Free models end in ":free" and
# rotate; pick one that lists tool support at openrouter.ai/models?q=free.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-oss-120b:free"

# Any other OpenAI-compatible endpoint (Together, DeepSeek, SambaNova, a local
# Ollama at http://localhost:11434/v1, LM Studio, ...). BASE_URL and MODEL are
# required; the key is optional for local servers. NAME is what the Operator
# tells visitors their messages are sent to.
# OPENAI_COMPATIBLE_BASE_URL="https://api.together.xyz/v1"
# OPENAI_COMPATIBLE_API_KEY=""
# OPENAI_COMPATIBLE_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
# OPENAI_COMPATIBLE_NAME="Together AI"

# Anthropic (optional) — keeps Claude's adaptive thinking and prompt caching.
# ANTHROPIC_API_KEY="sk-ant-<your-key>"

# Optional. "false" turns the Operator off; anything else (or unset) leaves it
# on. POST /api/operator honours it on every request (503), and so does
# GET /api/operator (204 on, 503 off). The launcher, though, is rendered into
# the pages: prerendered pages (cities, …) keep showing it until the next
# build, ISR pages (blogs, newsroom) until they revalidate, and only
# force-dynamic pages (industries, …) drop it at once. On Vercel an env change
# needs a redeploy anyway, which rebuilds everything; on a self-hosted
# `next start` or container, rebuild to hide the launcher everywhere.
OPERATOR_ENABLED="true"

# The route's own rate limit (20 requests / 10 min, 150 / day per IP) is
# in-memory and per instance, so it is best effort only. On Vercel, also add a
# Firewall rate-limit rule for the path /api/operator (Project → Firewall →
# Rules → Rate Limit, keyed by IP) so abuse is stopped before it is billed.
# Both count requests, not tokens: for any paid key, also set a monthly spend
# limit in that provider's console (Anthropic: Console → Settings → Limits).
