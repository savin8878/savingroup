# Blog posts are read from Supabase Postgres (table public.blog_posts).
# Runtime connection: the read-only `blog_reader` role through the transaction
# pooler (port 6543). Required — builds fail without it. See supabase/README.md.
DATABASE_URL="postgresql://blog_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Admin connection (session pooler, port 5432) — only for schema changes and
# seeding from your machine. Do NOT add this one to Vercel.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Shared secret for POST /api/revalidate/blog (Supabase webhook header
# `x-revalidate-secret`). Optional; without it edits appear within ~6 minutes.
BLOG_REVALIDATE_SECRET="<long-random-string>"

# Savin Operator (the site-wide AI chat panel, POST /api/operator).
# Anthropic API key. Required for the Operator; server-only — never prefix it
# with NEXT_PUBLIC_. Without it the route answers 503 and the panel shows an
# "unavailable" message instead of replying.
ANTHROPIC_API_KEY="sk-ant-<your-key>"

# Optional. "false" hides the Operator launcher and disables /api/operator.
# Anything else (or unset) leaves it on.
OPERATOR_ENABLED="true"

# The route's own rate limit (20 requests / 10 min, 150 / day per IP) is
# in-memory and per instance, so it is best effort only. On Vercel, also add a
# Firewall rate-limit rule for the path /api/operator (Project → Firewall →
# Rules → Rate Limit, keyed by IP) so abuse is stopped before it is billed.
